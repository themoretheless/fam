{
  "name": "fam-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:sites": "vite --config vite.sites.config.ts",
    "build": "vite build",
    "build:sites": "vite build --config vite.sites.config.ts",
    "preview": "vite preview",
    "preview:sites": "vite preview --config vite.sites.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "typecheck:worker": "tsc --project tsconfig.worker.json",
    "check:sites": "npm run typecheck:worker && npm test && npm run build:sites"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^5.2.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "4.118.0"
  }
}
